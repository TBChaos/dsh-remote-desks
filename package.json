{
  "name": "dsh-remote-desks",
  "version": "0.1.0",
  "private": true,
  "description": "把本机 / WSL / 远端 DSH 的 WebUI 镜像进桌面版 DSH，并在同一界面里启动、停止这些实例。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mirror",
    "remote",
    "wsl",
    "ssh"
  ],
  "license": "MIT",
  "author": "TBChaos",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "wsl-relay.cjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm run smoke",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:electron": "node scripts/verify-electron-local.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.6",
    "electron": "^44.4.5",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1"
  },
  "engines": {
    "node": ">=20"
  }
}
