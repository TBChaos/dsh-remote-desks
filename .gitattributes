# Normalize line endings in the repository so a Windows checkout and a Linux
# checkout produce identical commits.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.ico binary

# Generated or vendored artifacts are excluded from language statistics.
pnpm-lock.yaml linguist-generated=true
